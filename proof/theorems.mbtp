// ============================================================================
// proof — 以 SMT 求解器（z3）在編譯期證明的引理
//
// 每個 lemma 都是 `moon prove` 產生的證明義務；證明由 Why3 → z3 完成，
// 不是執行期 assert，而是「編譯期檢查」的定理。
// 這些引理支撐其他套件中的演算法與定理。
// ============================================================================

// ---------------------------------------------------------------------------
// 1. 熱帶化 (min-plus)：⊕ = min、⊗ = +
// ---------------------------------------------------------------------------

///|
fn min_i(a : Int, b : Int) -> Int {
  if a <= b {
    a
  } else {
    b
  }
}

///|
fn max_i(a : Int, b : Int) -> Int {
  if a <= b {
    b
  } else {
    a
  }
}

///|
/// 熱帶加法之交換律。
lemma trop_add_comm(a : Int, b : Int) where {
  proof_ensure: min_i(a, b) == min_i(b, a),
} {}

///|
/// 熱帶加法之結合律。
lemma trop_add_assoc(a : Int, b : Int, c : Int) where {
  proof_ensure: min_i(min_i(a, b), c) == min_i(a, min_i(b, c)),
} {}

///|
/// 熱帶加法單位元：+∞ 以極大整數代表，於此陳述「a ⊕ a = a」（冪等律）。
lemma trop_add_idem(a : Int) where {
  proof_ensure: min_i(a, a) == a,
} {}

///|
/// 熱帶分配律：a ⊗ (b ⊕ c) = (a ⊗ b) ⊕ (a ⊗ c)，即
///     a + min(b, c) = min(a + b, a + c).
lemma trop_distrib(a : Int, b : Int, c : Int) where {
  proof_ensure: min_i(a + b, a + c) == a + min_i(b, c),
} {}

// ---------------------------------------------------------------------------
// 2. 格及序：吸收律、分配律
// ---------------------------------------------------------------------------

///|
/// 吸收律 (1)：a ∨ (a ∧ b) = a.
lemma lattice_absorb_join(a : Int, b : Int) where {
  proof_ensure: max_i(a, min_i(a, b)) == a,
} {}

///|
/// 吸收律 (2)：a ∧ (a ∨ b) = a.
lemma lattice_absorb_meet(a : Int, b : Int) where {
  proof_ensure: min_i(a, max_i(a, b)) == a,
} {}

///|
/// 分配律：a ∧ (b ∨ c) = (a ∧ b) ∨ (a ∧ c).
lemma lattice_distrib(a : Int, b : Int, c : Int) where {
  proof_ensure: min_i(a, max_i(b, c)) == max_i(min_i(a, b), min_i(a, c)),
} {}

// ---------------------------------------------------------------------------
// 3. 導範疇：整數無撓 ⟹ 不存在 Z/2 → Z 的非零群同態
// ---------------------------------------------------------------------------

///|
/// 2a = 0 ⟹ a = 0（Z 無撓）。
/// 這是「Z/2 → Z 的群同態必為零」的核心，用於證明
/// Z/2[0] 與 [Z --2--> Z] 之間的準同構不是同倫等價。
lemma int_torsion_free(a : Int) where {
  proof_require: 2 * a == 0,
  proof_ensure: a == 0,
} {}

///|
/// 若 a * b = 0 且 a ≠ 0，則對所有 x，a * (b * x) = 0；
/// 這是「∂∘∂ = 0 ⟹ im ⊆ ker」的算術核心。
lemma complex_im_in_ker(a : Int, b : Int, x : Int) where {
  proof_require: a * b == 0,
  proof_ensure: a * (b * x) == 0,
} {}

// ---------------------------------------------------------------------------
// 4. 泰希米勒空間：Γ(2) 的代數恆等式
// ---------------------------------------------------------------------------

///|
/// 二階方陣乘積的跡的交換律：tr(AB) = tr(BA)。
lemma trace_comm(
  a11 : Int,
  a12 : Int,
  a21 : Int,
  a22 : Int,
  b11 : Int,
  b12 : Int,
  b21 : Int,
  b22 : Int,
) where {
  proof_ensure: (a11 * b11 + a12 * b21) + (a21 * b12 + a22 * b22) == (b11 * a11 + b12 * a21) + (b21 * a12 + b22 * a22),
} {}

///|
/// 行列式乘積公式 det(AB) = det(A)·det(B)（2×2），
/// 用於驗證 Γ(2) 對乘法封閉（det = 1 的元素成群）。
lemma det_mul(
  a11 : Int,
  a12 : Int,
  a21 : Int,
  a22 : Int,
  b11 : Int,
  b12 : Int,
  b21 : Int,
  b22 : Int,
) where {
  proof_ensure: (a11 * b11 + a12 * b21) * (a21 * b12 + a22 * b22) - (a11 * b12 + a12 * b22) * (a21 * b11 + a22 * b21) == (a11 * a22 - a12 * a21) * (b11 * b22 - b12 * b21),
} {}

// ---------------------------------------------------------------------------
// 5. 範疇化：基數的么半律
// ---------------------------------------------------------------------------

///|
fn nonneg2(a : Int, b : Int) -> Bool {
  (0 <= a) && (0 <= b)
}

///|
/// |A ⊔ B| = |A| + |B| 之交換律見證（有限集合的餘積）。
lemma card_union_comm(a : Int, b : Int) where {
  proof_require: nonneg2(a, b),
  proof_ensure: a + b == b + a,
} {}

// ---------------------------------------------------------------------------
// 6. 路徑空間：自由群中 aa⁻¹ 消去的長度不增性
// ---------------------------------------------------------------------------

///|
fn reduce_pre(n : Int, k : Int) -> Bool {
  (0 <= k) && (2 * k <= n)
}

///|
fn reduce_post(n : Int, k : Int) -> Bool {
  (0 <= n - 2 * k) && (n - 2 * k <= n)
}

///|
/// 每消去一對 aa⁻¹ 減少 2 個字母；若共消去 k 對，剩餘長度 = n − 2k，
/// 滿足 0 ≤ n − 2k ≤ n（終止性與不增性）。
lemma reduce_len(n : Int, k : Int) where {
  proof_require: reduce_pre(n, k),
  proof_ensure: reduce_post(n, k),
} {}

// ---------------------------------------------------------------------------
// 7. 尼雲維奇拓撲：拉回時穩定子的包含關係
// ---------------------------------------------------------------------------

///|
/// 以子群格的序骨架表述拉回步驟：若 Stab(z) ⊆ Stab(x)（記為 s ≤ t），
/// 則交 Stab(x) ∩ Stab(z) = Stab(z)（格下確界等於較小者）。
/// 具體的穩定子計算（遮罩交集）由 nis 套件以窮舉計算完成。
lemma pullback_stab_order(s : Int, t : Int) where {
  proof_require: s <= t,
  proof_ensure: min_i(s, t) == s,
} {}
